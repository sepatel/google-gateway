# OAuth client from Google Cloud (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public HTTPS address of the gateway. The OAuth redirect URI is
# ${PUBLIC_URL}/oauth/google/callback and must be registered on the client.
PUBLIC_URL=https://gmail.example.com

# name=token pairs, comma separated. One per caller so each can be revoked alone.
# Generate tokens with: openssl rand -base64 32
GATEWAY_CLIENTS=opencode=CHANGE_ME,post-office=CHANGE_ME

# Seals refresh tokens at rest. Generate with: openssl rand -base64 32
# Losing it means re-linking every account.
GATEWAY_ENCRYPTION_KEY=
