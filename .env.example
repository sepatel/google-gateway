# Settings can live here or be exported in the shell; docker compose reads either.

# OAuth client from Google Cloud (type: Web application).
GOOGLE_GATEWAY_GOOGLE_CLIENT_ID=
GOOGLE_GATEWAY_GOOGLE_CLIENT_SECRET=

# Address the browser uses to reach the gateway. The OAuth redirect URI is
# ${GOOGLE_GATEWAY_PUBLIC_URL}/oauth/google/callback and must be registered on the client.
# Use https on a server; http is accepted only for localhost.
GOOGLE_GATEWAY_PUBLIC_URL=http://localhost:47613

# name=token pairs, comma separated. One per caller so each can be revoked alone.
# Generate tokens with: openssl rand -base64 32
GOOGLE_GATEWAY_CLIENTS=opencode=CHANGE_ME,post-office=CHANGE_ME

# Seals refresh tokens at rest. Generate with: openssl rand -base64 32
# Losing it means re-linking every account.
GOOGLE_GATEWAY_ENCRYPTION_KEY=

# Host folder holding accounts.json, and the user that owns it. The folder must
# exist before the first start. Defaults: ~/.config/google-gateway and 1000:1000.
# GOOGLE_GATEWAY_HOST_DATA_DIR=/srv/google-gateway
# GOOGLE_GATEWAY_UID=1000
# GOOGLE_GATEWAY_GID=1000
